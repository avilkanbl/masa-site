<form id="rf" hidden>
<label>Görünen ad<input name="n" required minlength="2" maxlength="30" autocomplete="nickname"></label>
<label>Cinsiyet<select name="g" required><option value="">Seçin</option><option>Kadın</option><option>Erkek</option></select></label>
<label>Doğum tarihi<input type="date" name="b" required></label>
<label>E-posta<input type="email" name="e" required autocomplete="email"></label>
