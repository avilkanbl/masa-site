<div class="chk"><input type="checkbox" name="a" id="a18" required><label for="a18" style="margin:0;color:var(--ink)">18 yaşını doldurduğumu beyan ederim.</label></div>
<div class="chk"><input type="checkbox" name="k" id="kv" required><label for="kv" style="margin:0;color:var(--ink)">Kullanım koşullarını ve gizlilik metnini okudum, kabul ediyorum.</label></div>
<div style="margin-top:16px"><button class="btn-g" type="submit">Üye ol</button></div></form>
<div class="msg" id="amsg" role="status"></div></dialog>

<dialog id="accd" aria-labelledby="acct"><button class="close" aria-label="Kapat" data-close>&times;</button>
<h3 id="acct">Hesabım</h3><div id="accb">Yükleniyor…</div><div class="msg" id="accm" role="status"></div></dialog>

<dialog id="legd" class="wide legal"><button class="close" aria-label="Kapat" data-close>&times;</button>
<h3>Kullanım koşulları (özet)</h3>
<p>Masa’ya yalnızca 18 yaşını doldurmuş kişiler üye olabilir. Üyeler doğru bilgi vermekle yükümlüdür. Taciz, tehdit, sahte profil, ücret karşılığı buluşma ya da ödeme teklifi yasaktır ve hesabın kapatılmasına yol açar. Jetonlar yalnızca platformda kullanılır, devredilemez ve nakde çevrilemez. Buluşmalar üyelerin kendi sorumluluğundadır; kamuya açık mekânlar tercih edilmelidir.</p>
<h3>Gizlilik ve KVKK (özet)</h3>
<p>Ad, e-posta, doğum tarihi ve doğrulama fotoğrafı yalnızca hesabını yönetmek ve güvenliği sağlamak için işlenir. Fotoğraf diğer üyelere gösterilmez, yalnızca inceleme ekibi görür. Verilerin silinmesini ya da düzeltilmesini iletisim@isdambul.com.tr adresinden talep edebilirsin.</p></dialog>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
<script>
/* === AYAR: Supabase bilgilerini buraya yapıştırın (tırnakların içine) === */
const SUPABASE_URL="";
const SUPABASE_ANON_KEY="";
/* ========================================================================= */
const $=s=>document.querySelector(s),$$=s=>document.querySelectorAll(s);
const sb=(SUPABASE_URL&&SUPABASE_ANON_KEY&&window.supabase)?supabase.createClient(SUPABASE_URL,SUPABASE_ANON_KEY):null;
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));

/* ---- Slider ---- */
const S=[
 {h:262,t:"Cumartesi akşamı yalnız gitmek zorunda değilsin.",p:"Mekânı seç, masanı kur, ekibini tamamla."},
 {h:35,t:"Bir masa, dört yeni sohbet.",p:"Küçük, onaylı gruplarla rahat ve güvenli buluşmalar."},
 {h:205,t:"Eski dostlar gibi başlayan geceler.",p:"Herkes kendi hesabını öder, kimse yalnız kalmaz."},
 {h:330,t:"Önce onay, sonra masa.",p:"Odaya yalnızca oda sahibinin onayladığı kişiler katılır."}];
function scene(h,seed){let s=seed,r=()=>(s=(s*9301+49297)%233280)/233280,c="";
 for(let i=0;i<30;i++)c+=`<circle cx="${r()*100}%" cy="${r()*100}%" r="${1.5+r()*7}%" fill="hsl(${h+r()*60-15} 85% 62%)" opacity="${.1+r()*.3}"/>`;
 return `<svg aria-hidden="true"><defs><linearGradient id="g${seed}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="hsl(${h} 55% 14%)"/><stop offset="1" stop-color="hsl(${h+40} 60% 24%)"/></linearGradient><filter id="f${seed}"><feGaussianBlur stdDeviation="7"/></filter></defs><rect width="100%" height="100%" fill="url(#g${seed})"/><g filter="url(#f${seed})">${c}</g></svg>`}
const hero=$("#hero");
hero.innerHTML=S.map((x,i)=>`<div class="slide${i?"":" on"}" aria-hidden="${i?"true":"false"}">${scene(x.h,i+3)}<div class="wrap"><h1>${x.t}</h1><p>${x.p}</p><p style="margin-top:22px"><button class="btn-g" data-auth="register">Ücretsiz üye ol</button> <a class="btn" style="color:#fff;border-color:#fff" href="#nasil">Nasıl çalışır?</a></p></div></div>`).join("")+
 `<button class="arrow l" aria-label="Önceki">&#8249;</button><button class="arrow r" aria-label="Sonraki">&#8250;</button><div class="ctl">${S.map((_,i)=>`<button class="dot" aria-label="${i+1}. slayt" aria-current="${i==0}"></button>`).join("")}</div>`;
let cur=0,timer;
function go(n){cur=(n+S.length)%S.length;$$(".slide").forEach((e,i)=>{e.classList.toggle("on",i==cur);e.setAttribute("aria-hidden",i!=cur)});$$(".dot").forEach((e,i)=>e.setAttribute("aria-current",i==cur))}
function play(){stop();if(!matchMedia("(prefers-reduced-motion:reduce)").matches)timer=setInterval(()=>go(cur+1),6000)}
function stop(){clearInterval(timer)}
$(".arrow.l").onclick=()=>go(cur-1);$(".arrow.r").onclick=()=>go(cur+1);
$$(".dot").forEach((d,i)=>d.onclick=()=>go(i));
hero.onmouseenter=stop;hero.onmouseleave=play;hero.onfocusin=stop;hero.onfocusout=play;play();

/* ---- Diyaloglar ---- */
function msg(el,t,ok){el.className="msg "+(ok?"ok":"err");el.textContent=t}
function tab(reg){$("#lf").hidden=reg;$("#rf").hidden=!reg;$("#tl").setAttribute("aria-selected",!reg);$("#tr").setAttribute("aria-selected",reg);$("#amsg").className="msg"}
$("#tl").onclick=()=>tab(false);$("#tr").onclick=()=>tab(true);
document.addEventListener("click",async e=>{
 const a=e.target.closest("[data-auth]");
 if(a){const u=await user();if(u)return openAcc();tab(a.dataset.auth==="register");$("#authd").showModal();
  if(!sb)msg($("#amsg"),"Üyelik sistemi çok yakında açılıyor. Lütfen daha sonra tekrar deneyin.",false)}
 if(e.target.closest("[data-close]"))e.target.closest("dialog").close();
 if(e.target.closest("[data-legal]"))$("#legd").showModal();
});

/* ---- Üyelik ---- */
async function user(){if(!sb)return null;const{data}=await sb.auth.getSession();return data.session?data.session.user:null}
function adult(b){const d=new Date(b),n=new Date();let y=n.getFullYear()-d.getFullYear();if(n<new Date(n.getFullYear(),d.getMonth(),d.getDate()))y--;return y>=18}
$("#rf").onsubmit=async e=>{e.preventDefault();const m=$("#amsg");if(!sb)return msg(m,"Üyelik sistemi henüz açık değil.",false);
 const f=new FormData(e.target);
 if(!adult(f.get("b")))return msg(m,"Üye olmak için 18 yaşını doldurmuş olmalısın.",false);
 const{error}=await sb.auth.signUp({email:f.get("e"),password:f.get("p"),options:{data:{display_name:f.get("n").trim(),gender:f.get("g"),birth_date:f.get("b")}}});
 if(error)return msg(m,"Kayıt yapılamadı: "+error.message,false);
 msg(m,"Kaydın alındı. E-postana bir onay bağlantısı gönderdik; onayladıktan sonra giriş yapabilirsin.",true);e.target.reset()};
$("#lf").onsubmit=async e=>{e.preventDefault();const m=$("#amsg");if(!sb)return msg(m,"Üyelik sistemi henüz açık değil.",false);
 const f=new FormData(e.target);
 const{error}=await sb.auth.signInWithPassword({email:f.get("e"),password:f.get("p")});
 if(error)return msg(m,"Giriş yapılamadı. E-posta ve şifreni kontrol et.",false);
 await ensureProfile();$("#authd").close();refreshNav();openAcc()};
async function ensureProfile(){const u=await user();if(!u)return null;
 let{data}=await sb.from("profiles").select("*").eq("id",u.id).maybeSingle();
 if(!data){const md=u.user_metadata||{};
  const r=await sb.from("profiles").insert({id:u.id,display_name:md.display_name||"Üye",gender:md.gender,birth_date:md.birth_date}).select().single();data=r.data}
 return data}
const ST={none:"Fotoğrafın henüz gönderilmedi.",pending:"Fotoğrafın inceleniyor. Sonuç en kısa sürede hesabına yansır.",approved:"Profilin onaylandı. Artık oda kurabilir ve katılma isteği gönderebilirsin.",rejected:"Fotoğrafın uygun bulunmadı. Yüzünün net göründüğü yeni bir fotoğraf gönderebilirsin."};
async function openAcc(){$("#accd").showModal();$("#accm").className="msg";
 const p=await ensureProfile();if(!p){$("#accb").textContent="Profil yüklenemedi. Lütfen sayfayı yenile.";return}
 const canUp=p.photo_status!=="pending"&&p.photo_status!=="approved";
 $("#accb").innerHTML=`<p><strong>${esc(p.display_name)}</strong>${p.verified?" · <span style='color:#15602e'>Onaylı üye</span>":""}</p><p style="color:var(--mute)">${ST[p.photo_status]}</p>
 ${canUp?`<label>Kendi çektiğin bir fotoğraf (yüzün net görünmeli)<input type="file" id="ph" accept="image/*" capture="user"></label><div style="margin-top:14px"><button class="btn-g" id="up">Fotoğrafı gönder</button></div>`:""}
 <div style="margin-top:18px"><button id="out">Çıkış yap</button></div>`;
 $("#out").onclick=async()=>{await sb.auth.signOut();$("#accd").close();refreshNav()};
 const up=$("#up");if(up)up.onclick=async()=>{const fl=$("#ph").files[0],m=$("#accm");
  if(!fl)return msg(m,"Önce bir fotoğraf seç.",false);
  if(fl.size>6*1024*1024)return msg(m,"Fotoğraf 6 MB’tan küçük olmalı.",false);
  const u=await user(),ext=(fl.name.split(".").pop()||"jpg").toLowerCase().replace(/[^a-z0-9]/g,""),path=u.id+"/"+Date.now()+"."+ext;
  up.disabled=true;
  const a=await sb.storage.from("selfies").upload(path,fl);
  if(a.error){up.disabled=false;return msg(m,"Yüklenemedi: "+a.error.message,false)}
  const b=await sb.rpc("submit_photo",{p_path:path});
  if(b.error){up.disabled=false;return msg(m,"Gönderilemedi: "+b.error.message,false)}
  openAcc()}}
async function refreshNav(){const u=await user();
 $("#navbtn").innerHTML=u?`<button class="btn-g" data-auth="account">Hesabım</button>`:`<button data-auth="login">Giriş yap</button><button class="btn-g" data-auth="register">Üye ol</button>`}
if(sb){refreshNav();sb.auth.onAuthStateChange(()=>refreshNav())}
</script>
