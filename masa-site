  if(!sb)msg($("#amsg"),"Üyelik sistemi çok yakında açılıyor. Lütfen daha sonra tekrar deneyin.",false)}
 if(e.target.closest("[data-close]"))e.target.closest("dialog").close();

});

/* ---- Üyelik ---- */
async function user(){if(!sb)return null;const{data}=await sb.auth.getSession();return data.session?data.session.user:null}
function adult(b){const d=new Date(b),n=new Date();let y=n.getFullYear()-d.getFullYear();if(n<new Date(n.getFullYear(),d.getMonth(),d.getDate()))y--;return y>=18}
$("#rf").onsubmit=async e=>{e.preventDefault();const m=$("#amsg");if(!sb)return msg(m,"Üyelik sistemi henüz açık değil.",false);
 const f=new FormData(e.target);
 if(!adult(f.get("b")))return msg(m,"Üye olmak için 18 yaşını doldurmuş olmalısın.",false);
 const{error}=await sb.auth.signUp({email:f.get("e"),password:f.get("p"),options:{emailRedirectTo:location.origin+location.pathname,data:{display_name:f.get("n").trim(),gender:f.get("g"),birth_date:f.get("b")}}});
 if(error)return msg(m,"Kayıt yapılamadı: "+error.message,false);
 msg(m,"Kaydın alındı. E-postana bir onay bağlantısı gönderdik; onayladıktan sonra giriş yapabilirsin.",true);e.target.reset()};
$("#lf").onsubmit=async e=>{e.preventDefault();const m=$("#amsg");if(!sb)return msg(m,"Üyelik sistemi henüz açık değil.",false);
 const f=new FormData(e.target);
 const{error}=await sb.auth.signInWithPassword({email:f.get("e"),password:f.get("p")});
 if(error)return msg(m,"Giriş yapılamadı. E-posta ve şifreni kontrol et.",false);
 await ensureProfile();$("#authd").close();refreshNav();openAcc()};
async function ensureProfile(){const u=await user();if(!u)return null;
 let{data}=await sb.from("profiles").select("*").eq("id",u.id).maybeSingle();
 if(!data){const md=u.user_metadata||{};
  const r=await sb.from("profiles").insert({id:u.id,display_name:md.display_name||"Üye",gender:md.gender,birth_date:md.birth_date}).select().single();data=r.data}
 return data}
const ST={none:"Fotoğrafın henüz gönderilmedi.",pending:"Fotoğrafın inceleniyor. Sonuç en kısa sürede hesabına yansır.",approved:"Profilin onaylandı. Artık oda kurabilir ve katılma isteği gönderebilirsin.",rejected:"Fotoğrafın uygun bulunmadı. Yüzünün net göründüğü yeni bir fotoğraf gönderebilirsin."};
const RS={pending:"Bekliyor",approved:"Onaylandı",rejected:"Reddedildi",withdrawn:"Geri çekildi"};
async function openAcc(){$("#accd").showModal();$("#accm").className="msg";
 const p=await ensureProfile(),u=await user();if(!p){$("#accb").textContent="Profil yüklenemedi. Lütfen sayfayı yenile.";return}
 let bal=0,reqs=[];
 try{const r=await sb.from("my_token_balance").select("balance").single();bal=r.data?r.data.balance:0}catch(e){}
 try{const r=await sb.from("room_requests").select("id,status,rooms(title,venue)").order("created_at",{ascending:false}).limit(8);reqs=r.data||[]}catch(e){}
 const canUp=p.photo_status!=="pending"&&p.photo_status!=="approved";
 $("#accb").innerHTML=`<p><strong>${esc(p.display_name)}</strong>${p.verified?" · <span style='color:#15602e'>Onaylı üye</span>":""}<br><span style="color:var(--mute);font-size:.9rem">${esc(u.email)}</span></p>
 <p style="color:var(--mute)">${ST[p.photo_status]}</p>
 ${canUp?`<label>Kendi çektiğin bir fotoğraf (yüzün net görünmeli)<input type="file" id="ph" accept="image/*" capture="user"></label><div style="margin-top:14px"><button class="btn-g" id="up">Fotoğrafı gönder</button></div>`:""}
 <p style="margin-top:16px"><strong>Jeton bakiyesi:</strong> ${bal}</p>
 <h4 style="margin:18px 0 6px;font-family:Georgia,serif">Katılma isteklerim</h4>
 ${reqs.length?reqs.map(q=>`<div style="display:flex;justify-content:space-between;gap:8px;align-items:center;padding:8px 0;border-bottom:1px solid var(--line);font-size:.92rem"><span>${esc(q.rooms?q.rooms.title:"Oda")}<br><span style="color:var(--mute)">${esc(q.rooms?q.rooms.venue:"")} · ${RS[q.status]||q.status}</span></span>${q.status==="pending"?`<button data-wd="${q.id}" style="padding:5px 10px;font-size:.85rem">Geri çek</button>`:""}</div>`).join(""):'<p style="color:var(--mute);font-size:.92rem">Henüz isteğin yok.</p>'}
 <div style="margin-top:18px"><button id="out">Çıkış yap</button></div>`;
 $("#out").onclick=async()=>{await sb.auth.signOut();$("#accd").close();refreshNav()};
 $$("#accb [data-wd]").forEach(b=>b.onclick=async()=>{const r=await sb.rpc("withdraw_request",{req_id:b.dataset.wd});msg($("#accm"),r.error?r.error.message:"İstek geri çekildi.",!r.error);if(!r.error)openAcc()});
 const up=$("#up");if(up)up.onclick=async()=>{const fl=$("#ph").files[0],m=$("#accm");
  if(!fl)return msg(m,"Önce bir fotoğraf seç.",false);
  if(fl.size>6*1024*1024)return msg(m,"Fotoğraf 6 MB’tan küçük olmalı.",false);
  const ext=(fl.name.split(".").pop()||"jpg").toLowerCase().replace(/[^a-z0-9]/g,""),path=u.id+"/"+Date.now()+"."+ext;
  up.disabled=true;
  const a=await sb.storage.from("selfies").upload(path,fl);
  if(a.error){up.disabled=false;return msg(m,"Yüklenemedi: "+a.error.message,false)}
  const b=await sb.rpc("submit_photo",{p_path:path});
  if(b.error){up.disabled=false;return msg(m,"Gönderilemedi: "+b.error.message,false)}
  openAcc()}}
async function refreshNav(){const u=await user();
 const x=u?`<button class="btn-g" data-auth="account">Hesabım</button>`:`<button data-auth="login">Giriş yap</button><button class="btn-g" data-auth="register">Üye ol</button>`;
 $("#navbtn").innerHTML=x;$("#mauth").innerHTML=x}
if(sb){refreshNav();sb.auth.onAuthStateChange((ev)=>{refreshNav();if(ev==="PASSWORD_RECOVERY")$("#pwd").showModal()})}
$("#mauth").innerHTML=$("#navbtn").innerHTML;
/* mobil menü */
const bg=$("#burger"),mn=$("#mnav");
function menu(o){mn.hidden=!o;bg.setAttribute("aria-expanded",o);bg.innerHTML=o?"&times;":"&#9776;";bg.setAttribute("aria-label",o?"Menüyü kapat":"Menüyü aç")}
bg.onclick=()=>menu(mn.hidden);
mn.addEventListener("click",e=>{if(e.target.closest("a")||e.target.closest("button"))menu(false)});
/* şifre sıfırlama */
$("#forgot").onclick=async e=>{e.preventDefault();const m=$("#amsg"),em=$("#lf [name=e]").value.trim();
 if(!sb)return msg(m,"Üyelik sistemi henüz açık değil.",false);
 if(!em)return msg(m,"Önce e-posta adresini yaz.",false);
 const{error}=await sb.auth.resetPasswordForEmail(em,{redirectTo:location.origin+location.pathname});
 msg(m,error?"Gönderilemedi: "+error.message:"Şifre yenileme bağlantısı e-postana gönderildi.",!error)};
$("#pf").onsubmit=async e=>{e.preventDefault();const m=$("#pmsg");
 const{error}=await sb.auth.updateUser({password:new FormData(e.target).get("p")});
 if(error)return msg(m,"Şifre değiştirilemedi: "+error.message,false);
 msg(m,"Şifren güncellendi.",true);setTimeout(()=>$("#pwd").close(),1500)};
/* mekânlar */
let vAll=false;
function renderVenues(){const L=vAll?VENUES:VENUES.slice(0,12);
 $("#vgrid").innerHTML=L.map(v=>`<article class="vc">${vimg(v)}<div class="b"><h3>${esc(v.n)}</h3><div class="m">${v.d}</div><div>${v.c.map(k=>`<span class="chip">${CATS[k]}</span>`).join("")}</div><p style="margin:12px 0 0"><button data-vq="${v.id}">Bu mekânda oda ara</button></p></div></article>`).join("");
 $("#vmore").textContent=vAll?"Daha az göster":"Tüm mekânları göster ("+VENUES.length+")"}
$("#vmore").onclick=()=>{vAll=!vAll;renderVenues()};
document.addEventListener("click",e=>{const b=e.target.closest("[data-vq]");if(!b)return;const v=VM[b.dataset.vq];F.q=v.n;$("#fq").value=v.n;drawRooms();$("#odalar").scrollIntoView({behavior:"smooth"})});
renderVenues();
/* 18+ girişi */
(function(){let ok=false;try{ok=localStorage.getItem("age18")==="1"}catch(e){}
 if(ok)return;const d=$("#ageg");d.addEventListener("cancel",e=>e.preventDefault());d.showModal();
 $("#ageyes").onclick=()=>{try{localStorage.setItem("age18","1")}catch(e){}d.close()};
 $("#ageno").onclick=()=>{d.querySelector("p").textContent="Üzgünüz, bu siteye yalnızca 18 yaş ve üzeri kişiler girebilir.";$("#ageyes").remove();$("#ageno").remove()}})();
</script>
